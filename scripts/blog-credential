#!/bin/sh
# Git credential protocol only; never invoke directly to inspect its output.
set -eu
[ "${1:-}" = get ] || exit 0
protocol= host= path= username=
while IFS='=' read -r key value; do
    [ -n "$key" ] || break
    case "$key" in
        protocol) protocol=$value ;;
        host) host=$value ;;
        path) path=$value ;;
        username) username=$value ;;
    esac
done
[ "$protocol" = https ] || exit 0
[ "$host" = github.com ] || exit 0
case "$path" in Seung-Won-Yu/blog-writing.git|Seung-Won-Yu/blog-writing) ;; *) exit 0 ;; esac
case "$username" in ''|Seung-Won-Yu) ;; *) exit 0 ;; esac
unset GH_TOKEN GITHUB_TOKEN
token=$(/opt/homebrew/bin/gh auth token --hostname github.com --user Seung-Won-Yu) || exit 1
[ -n "$token" ] || exit 1
printf 'username=Seung-Won-Yu\npassword=%s\n\n' "$token"
